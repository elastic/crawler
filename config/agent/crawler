# Launcher executed by Elastic Agent for the crawler component. Agent passes the arguments
# configured in crawler.spec.yml (`agent`) and the connection details on STDIN.
# CRAWLER_HOME must point at a checkout of Open Crawler with its dependencies installed.

set -euo pipefail

CRAWLER_HOME="${CRAWLER_HOME:-/home/app}"
cd "${CRAWLER_HOME}"
exec bin/crawler "$@"
